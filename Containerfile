FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f AS build
WORKDIR /build
COPY app.py .

FROM python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f
ARG VERSION=dev
ARG COMMIT=unknown
ENV VERSION=${VERSION} COMMIT=${COMMIT} PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /build/app.py /app/app.py
USER 65532:65532
EXPOSE 8080
CMD ["python", "-B", "/app/app.py"]
